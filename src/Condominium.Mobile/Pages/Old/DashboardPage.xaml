<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Condominium.Mobile.Pages.Old.DashboardPage"
             Title="Painel Principal"
             BackgroundColor="#2c3e50">
    
    <Grid RowDefinitions="*,*" ColumnDefinitions="*" Padding="30" RowSpacing="20">
        
        <Button Grid.Row="0" 
                Text="Verificar Unidades" 
                Clicked="OnViewUnitsClicked"
                BackgroundColor="#F1C40F"
                TextColor="Black"
                FontAttributes="Bold"
                FontSize="20"
                CornerRadius="12" />

        <Button Grid.Row="1" 
                Text="Receber Encomenda" 
                Clicked="OnReceiveDeliveryClicked"
                BackgroundColor="#F1C40F"
                TextColor="Black"
                FontAttributes="Bold"
                FontSize="20"
                CornerRadius="12" />

    </Grid>
</ContentPage>
