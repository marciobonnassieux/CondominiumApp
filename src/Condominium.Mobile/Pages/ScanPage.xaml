<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cv="clr-namespace:Camera.MAUI;assembly=Camera.MAUI"
             x:Class="Condominium.Mobile.Pages.ScanPage"
             Title="Captura de Encomenda"
             BackgroundColor="Black">
    
    <Grid>
        <!-- ESTADO 1: Lente de Câmera Ativa -->
        <Grid x:Name="CameraGrid">
            <cv:CameraView x:Name="CameraControl" 
                           HorizontalOptions="Fill" 
                           VerticalOptions="Fill"
                           AutoSnapShotAsImageSource="True" />

            <!-- Botão de Disparo (📸) -->
            <Button Text="📸" 
                    Clicked="OnCaptureClicked"
                    BackgroundColor="#F1C40F"
                    TextColor="Black"
                    HorizontalOptions="Center"
                    VerticalOptions="End"
                    Margin="0,0,0,30"
                    WidthRequest="80"
                    HeightRequest="80"
                    CornerRadius="40"
                    FontSize="32" />
        </Grid>

        <!-- ESTADO 2: Revisão de Foto Detalhada (Sobreposição) -->
        <Grid x:Name="ReviewGrid" IsVisible="False">
            <ContentView>
                <ContentView.GestureRecognizers>
                    <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                    <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                </ContentView.GestureRecognizers>

                <Grid x:Name="ZoomableContainer">
                    <!-- Foto Estática (Congelada) -->
                    <Image x:Name="FrozenImage" 
                           Aspect="AspectFit"
                           HorizontalOptions="Fill" 
                           VerticalOptions="Fill" />

                    <!-- Camada de Realidade Aumentada (Interactive Overlay) -->
                    <GraphicsView x:Name="ArOverlay" 
                                  InputTransparent="False"
                                  HorizontalOptions="Fill" 
                                  VerticalOptions="Fill">
                        <GraphicsView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOverlayTapped" />
                        </GraphicsView.GestureRecognizers>
                    </GraphicsView>
                </Grid>
            </ContentView>
            
            <Button Text="Refazer Foto" 
                    Clicked="OnRetryClicked"
                    BackgroundColor="#CC2c3e50"
                    TextColor="White"
                    HorizontalOptions="Start"
                    VerticalOptions="End"
                    Margin="20" />
        </Grid>

        <!-- Loading / Processamento -->
        <Grid x:Name="LoadingOverlay" IsVisible="{Binding IsProcessing}" BackgroundColor="#80000000">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                <ActivityIndicator IsRunning="True" Color="#F1C40F" Scale="2" />
                <Label Text="Analisando Imagem..." TextColor="White" FontAttributes="Bold" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
