<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cv="clr-namespace:Camera.MAUI;assembly=Camera.MAUI"
             x:Class="Condominium.Mobile.Pages.ScanPage"
             Title="Captura de Encomenda"
             BackgroundColor="Black">
    
    <Grid>
        <!-- ESTADO 1: Lente de Câmera Ativa -->
        <Grid x:Name="CameraGrid">
            <cv:CameraView x:Name="CameraControl" 
                           HorizontalOptions="Fill" 
                           VerticalOptions="Fill"
                           AutoSnapShotAsImageSource="True" />

            <!-- Botão de Disparo (📸) -->
            <Button Text="📸" 
                    Clicked="OnCaptureClicked"
                    BackgroundColor="#F1C40F"
                    TextColor="Black"
                    HorizontalOptions="Center"
                    VerticalOptions="End"
                    Margin="0,0,0,30"
                    WidthRequest="80"
                    HeightRequest="80"
                    CornerRadius="40"
                    FontSize="32" />
        </Grid>

        <!-- ESTADO 2: Revisão de Foto Detalhada (Sobreposição) -->
        <Grid x:Name="ReviewGrid" IsVisible="False">
            <Grid x:Name="ZoomableContainer" BackgroundColor="Transparent">
                <!-- Camada de Realidade Aumentada (Interactive Overlay) -->
                <GraphicsView x:Name="ArOverlay" 
                              InputTransparent="False"
                              HorizontalOptions="Fill" 
                              VerticalOptions="Fill">
                    <GraphicsView.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                        <TapGestureRecognizer Tapped="OnOverlayTapped" />
                    </GraphicsView.GestureRecognizers>
                </GraphicsView>
            </Grid>
            
            <!-- Bottom Toolbar -->
            <Grid VerticalOptions="End" BackgroundColor="#1E1E1E" ColumnDefinitions="*,*,*,*,*" HeightRequest="70" Padding="10,0">
                <!-- BTN 1: Refazer -->
                <Button Grid.Column="0" Text="↺ Refazer" Clicked="OnRetryClicked" 
                        BackgroundColor="Transparent" TextColor="White" FontAttributes="Bold" FontSize="14" />
                
                <!-- BTN 1.5: Reanalisar Crop -->
                <Button Grid.Column="1" Text="⟳ Scanner" Clicked="OnReanalyzeClicked" 
                        BackgroundColor="Transparent" TextColor="#F1C40F" FontAttributes="Bold" FontSize="14" />
                
                <!-- BTN 2: Zoom Out -->
                <Button Grid.Column="2" Text="🔍-" Clicked="OnZoomOutClicked" 
                        BackgroundColor="Transparent" TextColor="White" FontAttributes="Bold" FontSize="20" />
                
                <!-- BTN 3: Zoom In -->
                <Button Grid.Column="3" Text="🔍+" Clicked="OnZoomInClicked" 
                        BackgroundColor="Transparent" TextColor="White" FontAttributes="Bold" FontSize="20" />
                
                <!-- BTN 4: Movimentação Toggle -->
                <Button x:Name="ModeBtn" Grid.Column="4" Text="✥" Clicked="OnModeToggleClicked" 
                        BackgroundColor="Transparent" TextColor="White" FontAttributes="Bold" FontSize="26" />
            </Grid>
        </Grid>

        <!-- Loading / Processamento -->
        <Grid x:Name="LoadingOverlay" IsVisible="{Binding IsProcessing}" BackgroundColor="#80000000">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                <ActivityIndicator IsRunning="True" Color="#F1C40F" Scale="2" />
                <Label Text="Analisando Imagem..." TextColor="White" FontAttributes="Bold" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
